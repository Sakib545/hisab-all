import re
from datetime import datetime
from pathlib import Path
import pytesseract
from PIL import Image, ImageOps, ImageEnhance, ImageFilter
from config import TESSERACT_CMD, OCR_LANG

if TESSERACT_CMD:
    pytesseract.pytesseract.tesseract_cmd = TESSERACT_CMD

BANKS = {
    "Dutch-Bangla Bank":[r"dutch[- ]?bangla",r"dbbl"],
    "BRAC Bank":[r"brac bank"],
    "City Bank":[r"city bank",r"citytouch"],
    "Eastern Bank":[r"eastern bank",r"\bebl\b"],
    "Pubali Bank":[r"pubali"],
    "Islami Bank Bangladesh":[r"islami bank",r"ibbl"],
    "Sonali Bank":[r"sonali bank"],
    "Janata Bank":[r"janata bank"],
    "Agrani Bank":[r"agrani bank"],
    "UCB":[r"united commercial bank",r"\bucb\b"],
    "bKash":[r"bkash"], "Nagad":[r"nagad"],
    "Rocket":[r"rocket"], "Upay":[r"upay"]
}

def extract_text(path):
    img=Image.open(Path(path))
    img=ImageOps.exif_transpose(img).convert("L")
    if img.width < 1500:
        scale=1500/img.width
        img=img.resize((1500,int(img.height*scale)))
    img=ImageOps.autocontrast(img)
    img=ImageEnhance.Contrast(img).enhance(1.8)
    img=img.filter(ImageFilter.SHARPEN)
    return pytesseract.image_to_string(img,lang=OCR_LANG,config="--psm 6")

def first(patterns,text):
    for p in patterns:
        m=re.search(p,text,re.I)
        if m:
            return (m.group(1) if m.groups() else m.group(0)).strip()
    return ""

def extract_reference_id(text):
    patterns = [
        r"(?im)^\s*(?:transaction\s*id|transaction\s*no|txn\s*id|txn\s*no|trx\s*id|trx\s*no|reference\s*id|reference\s*no|ref\s*id|ref\s*no)\s*[:#-]?\s*([A-Z0-9][A-Z0-9/_-]{5,40})\s*$",
        r"(?i)\b(?:transaction\s*id|txn\s*id|trx\s*id|reference\s*id|ref\s*id)\s*[:#-]\s*([A-Z0-9][A-Z0-9/_-]{5,40})\b",
    ]

    for p in patterns:
        m = re.search(p, text)
        if m:
            v = m.group(1).strip().upper()
            if v.isdigit() and len(v) >= 12:
                continue
            return v
    return ""


def parse_receipt(text):
    low=text.lower()
    bank="Unknown"
    for name, pats in BANKS.items():
        if any(re.search(p,low,re.I) for p in pats):
            bank=name; break

    nums=[]
    for x in re.findall(r"(?:amount|paid|total|debit|bdt|tk|৳)[^0-9]{0,15}([0-9][0-9,]*(?:\.[0-9]{1,2})?)",text,re.I):
        try:
            v=float(x.replace(",",""))
            if 0<v<100000000: nums.append(v)
        except: pass
    amount=max(nums) if nums else 0.0

    raw_date=first([
        r"\b(\d{4}[-/.]\d{1,2}[-/.]\d{1,2})\b",
        r"\b(\d{1,2}[-/.]\d{1,2}[-/.]\d{4})\b"
    ],text)
    day=datetime.now().date().isoformat()
    for fmt in ("%Y-%m-%d","%Y/%m/%d","%d-%m-%Y","%d/%m/%Y"):
        try:
            day=datetime.strptime(raw_date,fmt).date().isoformat(); break
        except: pass

    return {
        "bank_name":bank,
        "receiver_name":first([r"(?:receiver|recipient|beneficiary|sent to|to)[\s:#-]*([A-Za-z][A-Za-z .'-]{2,40})"],text),
        "account_number":first([r"(?:account|a/c|mobile|wallet)[\s:#-]*([0-9Xx* -]{6,30})"],text),
        "amount":amount,
        "transaction_date":day,
        "transaction_time":first([r"\b(\d{1,2}:\d{2}(?::\d{2})?\s*(?:AM|PM)?)\b"],text).upper(),
        "reference_id": extract_reference_id(text),
        "remarks":"",
        "raw_text":text
    }
